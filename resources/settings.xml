<settings version="2">
    <section id="script.iptv.xtream-to-m3u">
        <category id="cat_account" label="30100">
            <group id="1" label="30110">
                <setting id="xtream_host" type="string" label="30101" help="30500">
                    <level>0</level>
                    <default>http://host</default>
                    <control type="edit" format="string" />
                </setting>
                <setting id="xtream_port" type="string" label="30102">
                    <level>0</level>
                    <default>80</default>
                    <control type="edit" format="string" />
                </setting>
                <setting id="username" type="string" label="30103">
                    <level>0</level>
                    <default>user</default>
                    <control type="edit" format="string" />
                </setting>
                <setting id="password" type="string" label="30104" option="hidden">
                    <level>0</level>
                    <default>pass</default>
                    <control type="edit" format="string" option="hidden" />
                </setting>
            </group>
            <group id="2" label="30111">
                <setting id="select_pvr_instance" type="action" label="30105">
                    <level>0</level>
                    <data>RunScript(script.iptv.xtream-to-m3u, "action=select_pvr_instance")</data>
                    <control type="button" format="action" />
                </setting>
                <setting id="pvr_instance_name" type="string" label="30106" default="">
                    <enable>false</enable>
                    <level>0</level>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string" />
                </setting>
                <setting id="pvr_instance_id" type="string" default="">
                    <visible>false</visible>
                    <level>0</level>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string" />
                </setting>
                <setting id="select_categories_btn" type="action" label="30107" help="30501">
                    <level>0</level>
                    <data>RunScript(script.iptv.xtream-to-m3u, "action=select_categories")</data>
                    <control type="button" format="action" />
                </setting>
                <setting id="user_categories_ids" type="string" label="30107" default="">
                    <visible>false</visible>
                    <enable>false</enable>
                    <level>0</level>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string" />
                </setting>
                <setting id="m3u_filename" type="string" label="30108">
                    <level>0</level>
                    <default>xtream-to-m3u.m3u</default>
                    <control type="edit" format="string" />
                </setting>
            </group>
        </category>
        <category id="cat_filters" label="30200">
            <group id="1" label="30210">
                <setting id="exclude_prefixes" type="string" label="30201" default="" help="30507">
                    <level>0</level>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string" />
                </setting>
                <setting id="strip_prefixes" type="boolean" label="30202" help="30508">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle" />
                </setting>
            </group>
        </category>
        <category id="cat_actions" label="30300">
            <group id="1" label="30310">
                <setting id="system_checks" type="action" label="30301">
                    <level>0</level>
                    <data>RunScript(script.iptv.xtream-to-m3u, "action=system_checks")</data>
                    <control type="button" format="action" />
                </setting>
            </group>
            <group id="2" label="30311">
                <setting id="setup_pvr" type="action" label="30302" help="30502">
                    <level>0</level>
                    <data>RunScript(script.iptv.xtream-to-m3u, "action=setup_pvr")</data>
                    <control type="button" format="action" />
                </setting>
                <setting id="sync_to_pvr" type="action" label="30304" help="30504">
                    <level>0</level>
                    <data>RunScript(script.iptv.xtream-to-m3u, "action=sync_to_pvr")</data>
                    <control type="button" format="action" />
                </setting>
                <setting id="refresh_pvr" type="action" label="30305" help="30505">
                    <level>0</level>
                    <data>RunScript(script.iptv.xtream-to-m3u, "action=refresh_pvr")</data>
                    <control type="button" format="action" />
                </setting>
            </group>
        </category>
    </section>
</settings>