                    <data>RunScript(script.iptv.xtream-to-m3u, "action=select_pvr_instance")</data>
                    <control type="button" format="action" />
                </setting>
                <setting id="pvr_instance_name" type="string" label="30106">
                    <enable>false</enable>
                    <level>0</level>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string" />
                </setting>
                <setting id="pvr_instance_id" type="string">
                    <visible>false</visible>
                    <level>0</level>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string" />
                </setting>
                <setting id="m3u_path" type="path" label="30108" help="30509">
                    <level>0</level>
                    <default>special://home/userdata/playlists</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="path" />
                </setting>
            </group>
            <group id="2" label="30111">
