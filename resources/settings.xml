                    <control type="edit" format="string" />
                </setting>
                <setting id="xtream_port" type="string" label="30102">
                    <level>0</level>
                    <default>80</default>
                    <control type="edit" format="string" />
                </setting>
                <setting id="username" type="string" label="30103">
                    <level>0</level>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string" />
                </setting>
                <setting id="password" type="string" label="30104">
                    <level>0</level>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <hidden>true</hidden>
                    </control>
                </setting>
                <setting id="test_provider" type="action" label="30109" help="30511">
                    <level>0</level>
                    <data>RunScript(script.iptv.xtream-to-m3u, "action=test_provider")</data>
                    <control type="button" format="action" />
